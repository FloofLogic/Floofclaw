{
  "id": "write_file",
  "description": "Write UTF-8 text content to a workspace-relative file path. Managed operation: call with op:start \u2014 result arrives on a later turn as an operation_result envelope confirming the write with the path.",
  "outside_world": true,
  "args_schema": {
    "type": "object",
    "required": [
      "op"
    ],
    "additionalProperties": false,
    "properties": {
      "op": {
        "type": "string",
        "enum": [
          "start"
        ],
        "description": "'start' writes and finishes immediately."
      },
      "path": {
        "type": "string",
        "description": "Workspace-relative path to write. Required with op:start."
      },
      "content": {
        "type": "string",
        "description": "File content. Required with op:start."
      }
    }
  },
  "exec": [
    "runtime",
    "fc_write_file()"
  ],
  "timeout_ms": 0,
  "contract": "managed_operation",
  "default_timeout_ms": 300000,
  "max_timeout_ms": 600000
}
