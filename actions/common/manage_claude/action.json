{
  "id": "manage_claude",
  "description": "Run Claude Code as a managed external operation. op:start detaches the worker and completes through the runtime's bus completion contract; op:status inspects a worker's local state; op:abort kills the worker and terminalizes its operation.",
  "outside_world": true,
  "args_schema": {
    "type": "object",
    "required": [
      "op"
    ],
    "additionalProperties": false,
    "properties": {
      "op": {
        "type": "string",
        "enum": [
          "start",
          "abort",
          "status"
        ],
        "description": "Operation to perform."
      },
      "task": {
        "type": "string",
        "description": "Task text for start."
      },
      "op_id": {
        "type": "string",
        "description": "Worker identifier from a prior start (its op_id), for abort or status."
      },
      "cwd": {
        "type": "string",
        "description": "Workspace-relative working directory."
      },
      "model": {
        "type": "string",
        "description": "Optional Claude model override."
      },
      "permission_mode": {
        "type": "string",
        "enum": [
          "safe",
          "dangerous"
        ],
        "description": "Permission mode. Defaults to safe."
      }
    }
  },
  "exec": [
    "runtime",
    "fc_manage_claude()"
  ],
  "timeout_ms": 0,
  "contract": "managed_operation",
  "default_timeout_ms": 1800000,
  "max_timeout_ms": 7200000
}
