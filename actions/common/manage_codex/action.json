{
  "id": "manage_codex",
  "description": "Run Codex as a managed external operation in the runtime workspace or an explicitly configured allowed project root, with start, poll, reply, abort, and status operations.",
  "outside_world": true,
  "args_schema": {
    "type": "object",
    "required": [
      "op"
    ],
    "additionalProperties": false,
    "properties": {
      "op": {
        "type": "string",
        "enum": [
          "start",
          "poll",
          "reply",
          "abort",
          "status"
        ],
        "description": "Operation to perform."
      },
      "task": {
        "type": "string",
        "description": "Task text for start."
      },
      "op_id": {
        "type": "string",
        "description": "Managed operation identifier for poll, reply, abort, or status."
      },
      "answer": {
        "type": "string",
        "description": "Follow-up answer for reply."
      },
      "cwd": {
        "type": "string",
        "description": "Existing working directory relative to the selected root. Absolute paths, empty components, dot-dot traversal, and symlink escape are rejected."
      },
      "root": {
        "type": "string",
        "enum": [
          "workspace",
          "project"
        ],
        "description": "Working-root selector for start. Defaults to workspace. Project requires actions.manage_codex.allowed_project_root."
      },
      "permission_mode": {
        "type": "string",
        "enum": [
          "safe",
          "dangerous"
        ],
        "description": "Permission mode. Defaults to safe."
      }
    }
  },
  "exec": [
    "runtime",
    "fc_manage_codex()"
  ],
  "config": [
    {
      "name": "ALLOWED_PROJECT_ROOT",
      "key": "allowed_project_root",
      "kind": "existing_directory",
      "required": false
    }
  ],
  "timeout_ms": 0,
  "contract": "managed_operation",
  "poll_handle_arg": "op_id"
}
